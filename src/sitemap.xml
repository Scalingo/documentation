---
layout: null
page_exclude: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for post in site.posts %}
  {% unless post.categories contains 'changelog' %}
    <url>
      <loc>{{ post.url | prepend: site.baseurl | prepend: site.url }}</loc>
      <priority>0.9</priority>
    </url>
  {% endunless %}
{% endfor %}
{% for post in site.pages %}
  <url>
    <loc>{{ post.url | prepend: site.baseurl | prepend: site.url }}</loc>
    <priority>0.5</priority>
  </url>
{% endfor %}
{% for tutorial in site.tutorials %}
  {% unless tutorial.deprecated == true %}
    <url>
      <loc>{{ tutorial.url | prepend: site.baseurl | prepend: site.url }}</loc>
      <priority>0.9</priority>
    </url>
  {% endunless %}
{% endfor %}
{% for category in site.tutorials_categories %}
  {% unless category.deprecated == true %}
    <url>
      <loc>{{ category.url | prepend: site.baseurl | prepend: site.url }}</loc>
      <priority>0.5</priority>
    </url>
  {% endunless %}
{% endfor %}

</urlset>
